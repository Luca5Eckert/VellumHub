{
  "name": "Cross-service workflows",
  "description": "Manually maintained cross-service checks. Obtain an Auth-issued access token using OAuth2 Authorization Code with PKCE, set the Postman `token` variable, then run the read-only sequence. The Auth service owns login and credentials; the User service owns profiles.",
  "item": [
    {
      "name": "01 - Validate Auth access token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{gatewayUrl}}/api/v1/users/me",
        "description": "Requires a canonical Auth-issued OAuth2 access token in the `token` variable. Obtain it with Authorization Code + PKCE (Auth issuer http://127.0.0.1:9000 in the local harness); do not invoke the removed User Service login endpoint."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Auth access token is configured\", function () { pm.expect(pm.variables.get(\"token\"), \"Auth-issued bearer token\").to.be.a(\"string\").and.not.be.empty; });",
              "pm.test(\"Canonical Auth token accepted by User\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.execution.setNextRequest(\"02 - List books and capture bookId\");"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - List books and capture bookId",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{gatewayUrl}}/api/v1/catalog/books?pageNumber=0&pageSize=10",
        "description": "Loads the first catalog page and stores the first book identifier in `bookId` for optional examples."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Catalog request succeeded\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const payload = pm.response.json();",
              "  const books = Array.isArray(payload) ? payload : (Array.isArray(payload.content) ? payload.content : []);",
              "  pm.test(\"Catalog contains at least one book\", function () { pm.expect(books.length).to.be.above(0); });",
              "  if (books.length > 0 && books[0].id) {",
              "    pm.environment.set(\"bookId\", books[0].id);",
              "    pm.collectionVariables.set(\"bookId\", books[0].id);",
              "    pm.execution.setNextRequest(\"03 - List my ratings\");",
              "  }",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 - List my ratings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{gatewayUrl}}/api/v1/engagement/rating/me?pageNumber=0&pageSize=10",
        "description": "Exercises the authenticated Engagement Service read path without mutating user state."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Ratings request succeeded\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.execution.setNextRequest(\"04 - Fetch recommendations\");"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 - Fetch recommendations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{gatewayUrl}}/api/v1/recommendations?limit=10&offset=0",
        "description": "Requests personalized recommendations after exercising authenticated user, catalog, and engagement paths."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Recommendations request succeeded\", function () { pm.response.to.have.status(200); });",
              "pm.execution.setNextRequest(null);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 - Optional: rate captured book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "text/plain",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"stars\": {{stars}},\n  \"review\": \"{{review}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{gatewayUrl}}/api/v1/engagement/rating",
        "description": "Optional state-changing example. Run manually after a `bookId` is captured. Re-running can conflict if the user already rated the same book."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Rating creation did not fail at the server layer\", function () { pm.expect(pm.response.code).to.be.below(500); });"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
