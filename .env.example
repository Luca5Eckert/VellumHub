# Local Compose database isolation: distinct users/passwords per PostgreSQL instance.
# Configure four independent random passwords in .env (not committed).
# Changing credentials does not reinitialize an existing PostgreSQL volume.
POSTGRES_CATALOG_USER=catalog_owner
POSTGRES_CATALOG_PASSWORD=change_me_catalog
POSTGRES_ENGAGEMENT_USER=engagement_owner
POSTGRES_ENGAGEMENT_PASSWORD=change_me_engagement
POSTGRES_USER_USER=user_owner
POSTGRES_USER_PASSWORD=change_me_user
POSTGRES_RECOMMENDATION_USER=recommendation_owner
POSTGRES_RECOMMENDATION_PASSWORD=change_me_recommendation
POSTGRES_AUTH_USER=auth_owner
POSTGRES_AUTH_PASSWORD=change_me_auth

# Auth-only signing keys. Directory must contain signing-private.pem and signing-public.pem.
VELLUM_AUTH_KEY_DIR=./.local/auth-keys
VELLUM_AUTH_ACTIVE_KID=local-auth-key-1
VELLUM_INTERNAL_PROVISION_KEY=change_me_internal_provision_key_32_chars
VELLUM_AUTH_ALLOWED_ORIGIN=http://127.0.0.1:9100
VELLUM_AUTH_ARGON2_MEMORY_KIB=19456
VELLUM_AUTH_ARGON2_ITERATIONS=2
VELLUM_AUTH_ARGON2_PARALLELISM=1

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://meusite.com

# Optional JVM override. The default is container-aware and enables the bundled OpenTelemetry agent.
JAVA_TOOL_OPTIONS=
SHUTDOWN_TIMEOUT=30s

# Token contract. Set production issuer to the actual trusted HTTPS Auth issuer.
JWT_ISSUER=http://127.0.0.1:9000
JWT_AUDIENCE=api://vellumhub
JWT_CLOCK_SKEW_SECONDS=30
