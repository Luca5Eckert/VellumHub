<?xml version="1.0" encoding="UTF-8"?>
<!-- CI-only fallback when Maven Central's primary endpoint intermittently
     fails to serve published plugins. Do not mirror the Confluent repository. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central-fallback</id>
      <name>Google Cloud Maven Central mirror (CI retry only)</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
